# ─────────────────────────────────────────────────────
# RENATHA Backend — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-secret-key

# ── Database ──────────────────────────────────────────
# SQLite (default for local development — no setup needed):
DATABASE_URL=sqlite:///./renatha.db

# MySQL (use this for production):
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/renatha_db
